<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout"
    android:background="@android:color/darker_gray"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_world" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:max="100"
        android:progress="40"
        android:layout_gravity="bottom" />

    <!-- Sidebar + menu -->
    <LinearLayout
        android:id="@+id/sidebarLayout"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:elevation="6dp"
        android:layout_gravity="center_vertical|start"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/menuButtonsLayout"
            style="?android:attr/buttonBarStyle"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/menu_background"
            android:elevation="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/profileButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_text"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/calendarButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_text"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/treeButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tree_text"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/noticeButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notice_text"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/menuToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_description"
        android:src="@drawable/ic_menu" />

</FrameLayout>